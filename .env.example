# ═══════════════════════════════════════════════════════════
# Causal-Ensemble Paper Scout — Environment Variables
#
# HOW TO USE LOCALLY:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to GitHub
#
# HOW TO USE ON RENDER:
#   Add each variable manually in:
#   Render Dashboard → your Worker → Environment → Add Environment Variable
#   DATABASE_URL is added automatically — do not add it manually.
# ═══════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
# Render populates DATABASE_URL automatically from the linked DB.
# For local use, build from your Postgres details:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://agent_user:agent_password@localhost:5432/causal_scout

# ── Scout Settings ────────────────────────────────────────────
# Key in PAPER_TRADE_CONFIGS dict inside causal_paper_scout.py
PAPER_SCOUT_BRAIN=causal_ensemble
# How often to scan in minutes (55 aligns with 1h candle close)
PAPER_SCOUT_INTERVAL_MIN=55

# ── ICICI Breeze (Indian real-time price fallback) ────────────
# Get these from: https://api.icicidirect.com → Login → API Keys
BREEZE_API_KEY=
BREEZE_SECRET=
BREEZE_SESSION_TOKEN=

# ── NOT needed for paper scout — kept for future reference ────
# FINNHUB_API_KEY=
# ANGEL_ONE_API_KEY=
# ANGEL_ONE_CLIENT_ID=
